{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "./out",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*", "src/**/*.tsx"]
}
